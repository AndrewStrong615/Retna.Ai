data/
synthetic/
processed*/
trainLabels*.csv
*.zip
*.7z

# Training outputs: checkpoints, histories, split files
runs/
*.pt
*.pth
*.ckpt

# Python and Jupyter clutter
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
